{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "dev",
            "path": "web",
            "label": "npm: dev",
            "detail": "Start frontend dev server",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "Local:"
                }
            },
            "presentation": {
                "group": "group",
                "reveal": "never",
                "panel": "dedicated"
            }
        },
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "go run main.go",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting",
                    "endsPattern": "Server started on"
                }
            },
            "presentation": {
                "group": "group",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Start Full Stack",
            "dependsOn": [
                "Start Backend",
                "npm: dev"
            ],
            "problemMatcher": []
        }
    ]
}