{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Frontend Only",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/web/src",
            "preLaunchTask": "npm: dev",
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/*"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Backend Only",
            "runtimeExecutable": "go",
            "runtimeArgs": [
                "run",
                "main.go"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Full Stack",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/web/src",
            "preLaunchTask": "Start Full Stack",
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/*"
            }
        }
    ]
}